      "held_out_question_id": "instr-go-toolchain-004-q1",
      "question": "For the current Go toolchain-selection controls in the frozen sources, what full GOTOOLCHAIN assignment is shipped as the distribution default, which two suffixes are the only valid suffixes on a versioned minimum-toolchain setting, and what full GODEBUG assignment enables toolchain-selection tracing?",
      "accepted_answers": [
        "GOTOOLCHAIN=auto; +auto and +path; GODEBUG=toolchaintrace=1"
      ],
      "required_source_ids": [
        "go-env-defaults-current",
        "go-toolchain-select-current",
        "go-toolchain-trace-current"
      ],
      "semantic_answer_requirements": {
        "required_groups": [
          ["GOTOOLCHAIN=auto"],
          ["+auto"],
          ["+path"],
          ["GODEBUG=toolchaintrace=1", "toolchaintrace=1"]
        ],
        "forbidden_terms": [
          "GOTOOLCHAIN=local"
        ]
